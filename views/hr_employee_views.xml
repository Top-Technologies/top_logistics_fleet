<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Employee Form -->
    <record id="view_employee_form_inherit_driver" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.driver</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Driver &amp; Logistics (FMS)" name="driver_management">
                    <group>
                        <group string="Driver Status &amp; Qualification">
                            <field name="is_driver" widget="boolean_toggle"/>
                            <field name="driver_status" widget="badge"
                                   decoration-success="driver_status == 'available'"
                                   decoration-info="driver_status == 'assigned'"
                                   decoration-warning="driver_status == 'on_trip'"
                                   decoration-danger="driver_status in ('leave', 'suspended', 'inactive')"/>
                            <field name="driver_assigned_vehicle_id"/>
                        </group>
                        <group string="Driving License Compliance">
                            <field name="driver_license_number"/>
                            <field name="license_category"/>
                            <field name="license_issue_date"/>
                            <field name="license_expiry_date"/>
                            <field name="license_compliance_status" readonly="1" class="fw-bold"/>
                            <field name="is_license_expired" invisible="1"/>
                        </group>
                    </group>
                    <group string="Emergency Contacts">
                        <group>
                            <field name="emergency_contact"/>
                        </group>
                        <group>
                            <field name="emergency_contact_phone"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Dedicated Driver List View (Read/Edit Only - Drivers managed in Employees module) -->
    <record id="view_employee_driver_list" model="ir.ui.view">
        <field name="name">hr.employee.driver.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Drivers Directory" sample="1" create="false" delete="false">
                <field name="name" decoration-bf="1"/>
                <field name="driver_status" widget="badge"
                       decoration-success="driver_status == 'available'"
                       decoration-info="driver_status == 'assigned'"
                       decoration-warning="driver_status == 'on_trip'"
                       decoration-danger="driver_status in ('leave', 'suspended', 'inactive')"/>
                <field name="driver_license_number"/>
                <field name="license_category"/>
                <field name="license_expiry_date" widget="date"
                       decoration-danger="is_license_expired"/>
                <field name="license_compliance_status" widget="badge"
                       decoration-danger="is_license_expired"
                       decoration-success="not is_license_expired"/>
                <field name="driver_assigned_vehicle_id"/>
                <field name="work_phone"/>
                <field name="emergency_contact"/>
                <field name="emergency_contact_phone"/>
            </list>
        </field>
    </record>

    <!-- Driver Action (Filtered Employees) -->
    <record id="action_top_fleet_drivers" model="ir.actions.act_window">
        <field name="name">Driver Directory</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_employee_driver_list"/>
        <field name="domain">[('is_driver', '=', True)]</field>
        <field name="context">{'default_is_driver': True, 'create': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No company drivers registered yet!
            </p>
            <p>
                Drivers are managed from the <strong>Employees</strong> module.<br/>
                To designate an employee as a driver, open their record in the Employees app and check <strong>Is Driver</strong> under the <em>Driver &amp; Logistics (FMS)</em> tab.
            </p>
        </field>
    </record>

    <!-- Available Drivers Action -->
    <record id="action_top_fleet_drivers_available" model="ir.actions.act_window">
        <field name="name">Available Drivers</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="view_id" ref="view_employee_driver_list"/>
        <field name="domain">[('is_driver', '=', True), ('driver_status', '=', 'available'), ('is_license_expired', '=', False)]</field>
        <field name="context">{'default_is_driver': True, 'create': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No available drivers right now!
            </p>
            <p>
                Drivers appear here when they are marked as <em>Available</em> and have a valid non-expired driving license.
            </p>
        </field>
    </record>
</odoo>
