<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Employee Form -->
    <record id="view_employee_form_inherit_driver" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.driver</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Driver &amp; Logistics (FMS)" name="driver_management">
                    <group>
                        <group string="Driver Status &amp; Qualification (Section 13)">
                            <field name="is_driver" widget="boolean_toggle"/>
                            <field name="driver_status" widget="badge"
                                   decoration-success="driver_status == 'available'"
                                   decoration-info="driver_status == 'assigned'"
                                   decoration-warning="driver_status == 'on_trip'"
                                   decoration-danger="driver_status in ('leave', 'suspended', 'inactive')"/>
                            <field name="driver_assigned_vehicle_id"/>
                        </group>
                        <group string="Driving License Compliance (Section 12)">
                            <field name="driver_license_number"/>
                            <field name="license_category"/>
                            <field name="license_issue_date"/>
                            <field name="license_expiry_date"/>
                            <field name="license_compliance_status" readonly="1" class="fw-bold"/>
                            <field name="is_license_expired" invisible="1"/>
                        </group>
                    </group>
                    <group string="Emergency Contacts">
                        <group>
                            <field name="emergency_contact"/>
                        </group>
                        <group>
                            <field name="emergency_contact_phone"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Driver Action (Filtered Employees) -->
    <record id="action_top_fleet_drivers" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_driver', '=', True)]</field>
        <field name="context">{'default_is_driver': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register company drivers!
            </p>
            <p>
                Keep track of driver licenses, categories, expiry dates, and real-time trip availability.
            </p>
        </field>
    </record>

    <!-- Available Drivers Action -->
    <record id="action_top_fleet_drivers_available" model="ir.actions.act_window">
        <field name="name">Available Drivers</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_driver', '=', True), ('driver_status', '=', 'available'), ('is_license_expired', '=', False)]</field>
        <field name="context">{'default_is_driver': True}</field>
    </record>
</odoo>
