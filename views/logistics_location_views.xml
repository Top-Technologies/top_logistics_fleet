<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Location List View -->
    <record id="view_top_logistics_location_list" model="ir.ui.view">
        <field name="name">top.logistics.location.list</field>
        <field name="model">top.logistics.location</field>
        <field name="arch" type="xml">
            <list string="Predefined Locations" sample="1">
                <field name="code" decoration-bf="1"/>
                <field name="name"/>
                <field name="location_type" widget="badge"/>
                <field name="city"/>
                <field name="contact_person"/>
                <field name="phone"/>
                <field name="geofence_id" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Location Form View -->
    <record id="view_top_logistics_location_form" model="ir.ui.view">
        <field name="name">top.logistics.location.form</field>
        <field name="model">top.logistics.location</field>
        <field name="arch" type="xml">
            <form string="Logistics Location">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Location Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Central Depot, Jimma Branch, Bonga Farm"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Basic Classification">
                            <field name="code" placeholder="e.g. HQ-ADD, HUB-ADA"/>
                            <field name="location_type"/>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Contact &amp; Coordinates">
                            <field name="contact_person" placeholder="Site supervisor or contact"/>
                            <field name="phone" widget="phone"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="geofence_id"/>
                        </group>
                    </group>
                    <group string="Address Details">
                        <field name="street" placeholder="Street or local road description"/>
                        <field name="city"/>
                        <field name="state_id" options="{'no_create': True}"/>
                        <field name="country_id" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page name="notes" string="Instructions &amp; Access Notes">
                            <field name="notes" placeholder="Loading dock access, gate instructions, working hours..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Location Search View -->
    <record id="view_top_logistics_location_search" model="ir.ui.view">
        <field name="name">top.logistics.location.search</field>
        <field name="model">top.logistics.location</field>
        <field name="arch" type="xml">
            <search string="Search Locations">
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="contact_person"/>
                <separator/>
                <filter string="Depots &amp; Hubs" name="filter_depots" domain="[('location_type', 'in', ('depot', 'warehouse', 'transit'))]"/>
                <filter string="Farms &amp; Sites" name="filter_farms" domain="[('location_type', 'in', ('farm', 'project_site'))]"/>
                <filter string="Branches" name="filter_branches" domain="[('location_type', '=', 'branch')]"/>
                <group expand="0" string="Group By">
                    <filter string="Location Type" name="group_type" context="{'group_by': 'location_type'}"/>
                    <filter string="City" name="group_city" context="{'group_by': 'city'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_top_logistics_location" model="ir.actions.act_window">
        <field name="name">Predefined Locations</field>
        <field name="res_model">top.logistics.location</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_top_logistics_location_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register predefined logistics locations, depots, farms, branches, and client delivery points.
            </p>
        </field>
    </record>
</odoo>

