<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Trip List View -->
    <record id="view_top_fleet_trip_list" model="ir.ui.view">
        <field name="name">top.fleet.trip.list</field>
        <field name="model">top.fleet.trip</field>
        <field name="arch" type="xml">
            <list string="Fleet Trips" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="fleet_order_type_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id" widget="many2one_avatar_user"/>
                <field name="origin_location_id" optional="show"/>
                <field name="destination_location_id" optional="show"/>
                <field name="origin" optional="hide"/>
                <field name="destination" optional="hide"/>
                <field name="total_stops_count" string="Stops" optional="show"/>
                <field name="planned_departure"/>
                <field name="planned_arrival"/>
                <field name="planned_distance" optional="hide"/>
                <field name="actual_distance" sum="Total Actual Distance (km)"/>
                <field name="variance_distance" string="Dist Diff" optional="hide" decoration-danger="variance_distance &gt; 20"/>
                <field name="actual_duration_display" string="Time Taken" optional="show"/>
                <field name="time_status" widget="badge" optional="show"
                       decoration-success="time_status == 'on_time'"
                       decoration-warning="time_status == 'slight_delay'"
                       decoration-danger="time_status == 'major_delay'"/>
                <field name="start_fuel" optional="hide"/>
                <field name="end_fuel" optional="hide"/>
                <field name="total_refueled" optional="hide"/>
                <field name="expected_fuel" optional="hide"/>
                <field name="actual_fuel" sum="Total Fuel Consumed (L)"/>
                <field name="variance_fuel" string="Fuel Diff" optional="hide" decoration-danger="variance_fuel &gt; 5"/>
                <field name="fuel_consumption_rate" string="Rate (L/100km)"/>
                <field name="fuel_utilization_status" widget="badge" optional="show"
                       decoration-success="fuel_utilization_status == 'efficient'"
                       decoration-info="fuel_utilization_status == 'normal'"
                       decoration-danger="fuel_utilization_status == 'excess'"/>
                <field name="fuel_consumption_method" optional="show" widget="badge"/>
                <field name="fuel_theft_suspected" widget="boolean_toggle" optional="show" decoration-danger="fuel_theft_suspected"/>
                <field name="planned_cost" optional="hide" sum="Total Planned Cost"/>
                <field name="total_trip_cost" optional="show" sum="Total Trip Cost" class="fw-bold"/>
                <field name="variance_cost" optional="hide" sum="Total Cost Variance" decoration-danger="variance_cost &gt; 0"/>
                <field name="cost_per_km" optional="hide"/>
                <field name="gps_status" widget="badge"
                       decoration-success="gps_status == 'online'"
                       decoration-danger="gps_status == 'offline'"
                       decoration-muted="gps_status == 'no_device'"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state in ('ready', 'dispatched')"
                       decoration-warning="state == 'in_transit'"
                       decoration-success="state in ('completed', 'reconciled', 'closed')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Trip Form View -->
    <record id="view_top_fleet_trip_form" model="ir.ui.view">
        <field name="name">top.fleet.trip.form</field>
        <field name="model">top.fleet.trip</field>
        <field name="arch" type="xml">
            <form string="Fleet Trip">
                <header>
                    <button name="action_confirm" string="Confirm Trip" type="object" class="btn-primary"
                            invisible="state != 'draft' or end_odometer &gt; 0"/>
                    
                    <button name="action_dispatch" string="Dispatch" type="object" class="btn-success"
                            invisible="state != 'ready'"
                            groups="top_logistics_fleet.group_fleet_officer,top_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="action_in_transit" string="Mark In Transit" type="object" class="btn-primary"
                            invisible="state != 'dispatched'"
                            groups="top_logistics_fleet.group_fleet_officer,top_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="action_view_on_map" string="View on Map" type="object" icon="fa-map-marker" class="btn-outline-primary"
                            invisible="not gps_device_id"/>
                    
                    <button name="action_open_return_wizard" string="Return Inspection &amp; Complete" type="object" class="btn-primary"
                            invisible="state != 'in_transit'"
                            groups="top_logistics_fleet.group_fleet_officer,top_logistics_fleet.group_fleet_manager"/>

                    <!-- Section 51: Mobile Fast Actions -->
                    <button name="action_record_fuel" string="Log Fuel Refill" type="object" icon="fa-tint" class="btn-outline-info"
                            invisible="state in ('draft', 'cancelled')"/>

                    <button name="action_report_accident" string="Report Incident" type="object" icon="fa-exclamation-triangle" class="btn-outline-danger"
                            invisible="state in ('draft', 'cancelled')"/>
                    
                    <button name="action_reconcile" string="Reconcile" type="object" class="btn-secondary"
                            invisible="state not in ('completed', 'draft') or (state == 'draft' and not end_odometer)"
                            groups="top_logistics_fleet.group_fleet_officer,top_logistics_fleet.group_logistics_finance,top_logistics_fleet.group_fleet_manager,top_logistics_fleet.group_logistics_admin"/>
                    
                    <button name="action_close" string="Close Trip" type="object" class="btn-success"
                            invisible="state != 'reconciled'"
                            groups="top_logistics_fleet.group_fleet_manager,top_logistics_fleet.group_logistics_admin"/>

                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-outline-warning"
                            invisible="state not in ('closed', 'reconciled')"
                            groups="top_logistics_fleet.group_logistics_admin"
                            confirm="Are you sure you want to reset this trip to Draft? This will reopen the trip for corrections and re-reconciliation."/>
                    
                    <button name="action_cancel" string="Cancel Trip" type="object" class="btn-secondary"
                            invisible="state in ('in_transit', 'completed', 'reconciled', 'closed', 'cancelled')"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,ready,dispatched,in_transit,completed,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Trip Number"/>
                        <h1>
                            <field name="name" class="text-primary"/>
                        </h1>
                    </div>

                    <group>
                        <group name="vehicle_driver_group" string="Vehicle &amp; Driver Allocation">
                            <field name="vehicle_id" readonly="state != 'draft'"/>
                            <field name="vehicle_last_service_date"/>
                            <field name="vehicle_next_service_date"/>
                            <field name="vehicle_service_status" widget="badge"
                                   decoration-danger="vehicle_service_status == 'due'"
                                   decoration-success="vehicle_service_status == 'ok'"/>
                            <field name="driver_id" readonly="state != 'draft'"/>
                            <field name="driver_license_expiry_date"/>
                            <field name="driver_license_compliance" widget="badge"
                                   decoration-danger="driver_is_license_expired"
                                   decoration-success="not driver_is_license_expired"/>
                            <field name="backup_driver_id" readonly="state != 'draft'"/>
                            <field name="trip_coordinator_id" readonly="state != 'draft'"/>
                        </group>
                        <group name="schedule_group" string="Schedule &amp; Classification">
                            <field name="fleet_order_type_id" options="{'no_create_edit': False}" placeholder="Select Request Approval (Subject)..." readonly="state != 'draft'"/>
                            <field name="trip_type_id" readonly="state != 'draft'"/>
                            <field name="inspection_id" readonly="state != 'draft'"/>
                            <field name="request_id" readonly="1"/>
                            <field name="request_ids" widget="many2many_tags" readonly="1" string="Consolidated Orders"/>
                            <field name="planned_departure" readonly="state != 'draft'"/>
                            <field name="planned_arrival" readonly="state != 'draft'"/>
                            <field name="actual_departure" readonly="state != 'draft'"/>
                            <field name="actual_arrival" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- Summary Metrics Cards -->
                    <div class="row g-2 my-2">
                        <div class="col-md-4">
                            <div class="card p-2 bg-light border text-center shadow-sm">
                                <div class="text-muted small text-uppercase fw-bold"><i class="fa fa-road text-primary me-1"/> Distance Traveled</div>
                                <div class="fs-4 fw-bold text-primary"><field name="actual_distance"/> km</div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card p-2 bg-light border text-center shadow-sm">
                                <div class="text-muted small text-uppercase fw-bold"><i class="fa fa-clock-o text-info me-1"/> Total Time Taken</div>
                                <div class="fs-4 fw-bold text-info"><field name="actual_duration_display"/></div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="card p-2 bg-light border text-center shadow-sm">
                                <div class="text-muted small text-uppercase fw-bold"><i class="fa fa-map-marker text-success me-1"/> Stops Visited</div>
                                <div class="fs-4 fw-bold text-success">
                                    <field name="completed_stops_count"/> / <field name="total_stops_count"/>
                                </div>
                                <div class="small text-muted">Cancelled: <field name="cancelled_stops_count"/> | Pending: <field name="pending_stops_count"/></div>
                            </div>
                        </div>
                    </div>

                    <!-- GPS Live Telemetry Banner -->
                    <div class="alert alert-secondary d-flex justify-content-between align-items-center mt-2" role="alert">
                        <div>
                            <strong><i class="fa fa-map-marker text-danger me-1"/> GPS Telemetry:</strong>
                            <span class="ms-2">Device: <field name="gps_device_id" class="fw-bold"/></span>
                            <span class="ms-3">Status: <field name="gps_status" widget="badge"/></span>
                            <span class="ms-3 text-muted" invisible="not current_address">(<field name="current_address"/>)</span>
                        </div>
                        <div class="text-end">
                            <span class="me-3">Speed: <strong><field name="current_speed"/> km/h</strong></span>
                            <span class="me-3">Odometer: <strong><field name="current_odometer"/> km</strong></span>
                            <span>Coordinates: <strong><field name="current_latitude"/>, <field name="current_longitude"/></strong></span>
                        </div>
                    </div>

                    <notebook>
                        <page name="route_page" string="Route &amp; Waypoints">
                            <group>
                                <group string="Trip Endpoints">
                                    <field name="origin_location_id" options="{'no_create_edit': False}" placeholder="Select Predefined Origin..." readonly="state != 'draft'"/>
                                    <field name="origin" placeholder="Specific origin address..." readonly="state != 'draft'"/>
                                    <field name="destination_location_id" options="{'no_create_edit': False}" placeholder="Select Predefined Destination..." readonly="state != 'draft'"/>
                                    <field name="destination" placeholder="Specific destination address..." readonly="state != 'draft'"/>
                                </group>
                                <group string="Distance &amp; Duration">
                                    <field name="actual_distance"/>
                                    <field name="actual_duration_display"/>
                                    <field name="cargo_required" widget="boolean_toggle"/>
                                </group>
                            </group>
                            <group name="cargo_details" string="📦 Cargo &amp; Freight Specifications" invisible="not cargo_required">
                                <group string="Loading Type, Product &amp; Location">
                                    <field name="cargo_load_type" widget="radio" options="{'horizontal': true}"/>
                                    <field name="cargo_product_id" options="{'no_create_edit': False}"/>
                                    <field name="cargo_loading_type_desc"/>
                                    <field name="cargo_location_description"/>
                                </group>
                                <group string="Capacity, Quantity &amp; Tariff">
                                    <label for="cargo_amount_qty" string="Amount In Quintal"/>
                                    <div class="o_row">
                                        <field name="cargo_amount_qty"/>
                                        <field name="cargo_uom_id" options="{'no_create': True}"/>
                                    </div>
                                    <label for="cargo_load_capacity" string="Load Capacity"/>
                                    <div class="o_row">
                                        <field name="cargo_load_capacity"/>
                                        <field name="cargo_capacity_uom_id" options="{'no_create': True}"/>
                                    </div>
                                    <label for="cargo_tariff_unit_price" string="Tariff (Unit Price) / Quintal"/>
                                    <div class="o_row">
                                        <field name="cargo_tariff_unit_price"/>
                                        <span class="text-muted ms-1 me-1">per Quintal</span>
                                        <field name="cargo_uom_id" readonly="1" class="oe_inline"/>
                                    </div>
                                    <field name="cargo_currency_id" invisible="1"/>
                                    <field name="cargo_total_tariff" widget="monetary" readonly="1"/>
                                    <field name="cargo_description"/>
                                </group>
                            </group>
                            <separator string="Intermediate Stops &amp; Consolidations"/>
                            <field name="waypoint_ids">
                                <list editable="bottom" decoration-muted="state == 'pending'" decoration-success="state == 'completed'" decoration-danger="state == 'cancelled'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="location_id" options="{'no_create_edit': False}" placeholder="Predefined Location..."/>
                                    <field name="location_name"/>
                                    <field name="stop_type" widget="badge"/>
                                    <field name="request_id" optional="show"/>
                                    <field name="cargo_or_passenger_notes" placeholder="Pick/drop details..."/>
                                    <field name="estimated_arrival"/>
                                    <field name="actual_arrival"/>
                                    <field name="actual_departure"/>
                                    <field name="time_spent_hours" string="Dwell (h)" optional="show"/>
                                    <field name="state" widget="badge"
                                           decoration-muted="state == 'pending'"
                                           decoration-success="state == 'completed'"
                                           decoration-danger="state == 'cancelled'"/>
                                    <field name="notes" optional="show"/>
                                    <button name="action_mark_completed" string="Mark Visited" type="object" icon="fa-check text-success" invisible="state == 'completed'"/>
                                    <button name="action_cancel_stop" string="Cancel Stop" type="object" icon="fa-times text-danger" invisible="state in ('completed', 'cancelled')"/>
                                </list>
                            </field>
                        </page>

                        <page name="fuel_logs_page" string="Fuel Refuels">
                            <group string="Trip Fuel Summary">
                                <group>
                                    <field name="start_fuel"/>
                                    <field name="end_fuel"/>
                                </group>
                                <group>
                                    <field name="actual_fuel"/>
                                    <field name="total_refueled"/>
                                    <field name="fuel_consumption_rate" class="fw-bold text-primary"/>
                                </group>
                            </group>
                            <separator string="Refuel Logs &amp; Receipts"/>
                            <field name="fuel_log_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="fuel_station"/>
                                    <field name="fuel_type"/>
                                    <field name="start_odometer" string="Start Odo"/>
                                    <field name="odometer" string="Refuel Odo"/>
                                    <field name="odometer_diff" string="Distance (km)"/>
                                    <field name="quantity" sum="Total Litres"/>
                                    <field name="unit_price"/>
                                    <field name="total_cost" sum="Total Cost"/>
                                    <field name="consumption_rate" string="L/100km" class="fw-bold text-primary"/>
                                    <field name="utilization_status" widget="badge"
                                           decoration-success="utilization_status == 'efficient'"
                                           decoration-info="utilization_status == 'normal'"
                                           decoration-danger="utilization_status == 'high'"/>
                                    <field name="payment_method"/>
                                </list>
                            </field>
                        </page>

                        <page name="events_page" string="GPS Events &amp; Alerts">
                            <field name="event_ids">
                                <list decoration-danger="severity == 'danger'" decoration-warning="severity == 'warning'">
                                    <field name="timestamp"/>
                                    <field name="name"/>
                                    <field name="event_type" widget="badge"/>
                                    <field name="severity" widget="badge"/>
                                    <field name="speed"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>

                        <page name="checklist_page" string="Pre-Dispatch Condition Checklist">
                            <group>
                                <group string="Mechanical &amp; Fluids">
                                    <field name="chk_tires" readonly="1"/>
                                    <field name="chk_engine" readonly="1"/>
                                    <field name="chk_oil" readonly="1"/>
                                    <field name="chk_coolant" readonly="1"/>
                                    <field name="chk_brakes" readonly="1"/>
                                    <field name="chk_lights" readonly="1"/>
                                </group>
                                <group string="Safety Tools &amp; Body">
                                    <field name="chk_spare_tire" readonly="1"/>
                                    <field name="chk_tools" readonly="1"/>
                                    <field name="chk_fire_extinguisher" readonly="1"/>
                                    <field name="chk_first_aid" readonly="1"/>
                                    <field name="chk_body_condition" readonly="1"/>
                                    <field name="chk_gps_online" readonly="1"/>
                                    <field name="chk_documents_valid" readonly="1"/>
                                </group>
                            </group>
                            <group string="Release Readings">
                                <group>
                                    <field name="start_odometer" readonly="state != 'draft'"/>
                                    <field name="start_fuel" readonly="state != 'draft'"/>
                                    <field name="start_fuel_level" readonly="state != 'draft'"/>
                                </group>
                                <group>
                                    <field name="dispatched_by_id"/>
                                    <field name="dispatch_date"/>
                                </group>
                            </group>
                        </page>

                        <page name="return_inspection_page" string="Post-Trip Return Inspection" invisible="state not in ('draft', 'completed', 'reconciled', 'closed')">
                            <group>
                                <group string="Mileage &amp; Fuel on Return">
                                    <field name="vehicle_returned" readonly="state not in ('draft', 'completed')"/>
                                    <field name="end_odometer" readonly="state not in ('draft', 'completed')"/>
                                    <field name="end_fuel" readonly="state not in ('draft', 'completed')"/>
                                    <field name="end_fuel_level" readonly="state not in ('draft', 'completed')"/>
                                    <field name="return_cleanliness" readonly="state not in ('draft', 'completed')"/>
                                </group>
                                <group string="Damage &amp; Defects Audit">
                                    <field name="has_damage" readonly="state not in ('draft', 'completed')"/>
                                    <field name="damage_description" invisible="not has_damage" readonly="state not in ('draft', 'completed')"/>
                                    <field name="accident_id" invisible="not accident_id"/>
                                    <field name="missing_equipment" readonly="state not in ('draft', 'completed')"/>
                                    <field name="new_defects" readonly="state not in ('draft', 'completed')"/>
                                </group>
                            </group>
                            <separator string="Driver Debrief &amp; Comments"/>
                            <field name="driver_comments" readonly="state not in ('draft', 'completed')"/>
                        </page>

                        <page name="instructions_page" string="Purpose &amp; Instructions">
                            <group>
                                <field name="purpose" readonly="state != 'draft'"/>
                                <field name="special_instructions" readonly="state != 'draft'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Trip Kanban View -->
    <record id="view_top_fleet_trip_kanban" model="ir.ui.view">
        <field name="name">top.fleet.trip.kanban</field>
        <field name="model">top.fleet.trip</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="planned_departure"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="o_kanban_record_title text-primary">
                                    <field name="name"/>
                                </strong>
                                <field name="state" widget="badge"/>
                            </div>
                            <div class="small mb-1">
                                <i class="fa fa-car me-1 text-muted"/> <field name="vehicle_id"/>
                            </div>
                            <div class="small mb-1">
                                <i class="fa fa-user me-1 text-muted"/> <field name="driver_id"/>
                            </div>
                            <div class="small mb-2 text-truncate">
                                <i class="fa fa-map-marker text-danger me-1"/> 
                                <field name="origin"/> ➔ <field name="destination"/>
                            </div>
                            <div class="border-top pt-1 small text-muted">
                                <i class="fa fa-clock-o me-1"/> <field name="planned_departure"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Trip Calendar View -->
    <record id="view_top_fleet_trip_calendar" model="ir.ui.view">
        <field name="name">top.fleet.trip.calendar</field>
        <field name="model">top.fleet.trip</field>
        <field name="arch" type="xml">
            <calendar string="Vehicle Availability &amp; Trip Schedule" date_start="planned_departure" date_stop="planned_arrival" color="vehicle_id" mode="month">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Trip Search View -->
    <record id="view_top_fleet_trip_search" model="ir.ui.view">
        <field name="name">top.fleet.trip.search</field>
        <field name="model">top.fleet.trip</field>
        <field name="arch" type="xml">
            <search string="Search Fleet Trips">
                <field name="name" string="Trip, Origin, or Destination"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('origin', 'ilike', self), ('destination', 'ilike', self)]"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="request_id"/>

                <separator/>
                <filter string="Ready for Dispatch" name="filter_ready" domain="[('state', '=', 'ready')]"/>
                <filter string="In Transit" name="filter_in_transit" domain="[('state', '=', 'in_transit')]"/>
                <filter string="Active Trips" name="filter_active" domain="[('state', 'in', ['ready', 'dispatched', 'in_transit'])]"/>
                <filter string="Completed Trips" name="filter_completed" domain="[('state', 'in', ['completed', 'reconciled', 'closed'])]"/>
                <separator/>
                <filter string="GPS Online" name="filter_gps_online" domain="[('gps_status', '=', 'online')]"/>
                <filter string="GPS Offline" name="filter_gps_offline" domain="[('gps_status', '=', 'offline')]"/>
                <separator/>
                <filter string="Suspected Fuel Loss" name="filter_fuel_theft" domain="[('fuel_theft_suspected', '=', True)]"/>
                <filter string="High Fuel Variance" name="filter_high_variance" domain="[('variance_fuel', '&gt;', 5)]"/>

                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Vehicle" name="group_by_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Driver" name="group_by_driver" context="{'group_by': 'driver_id'}"/>
                    <filter string="Trip Type" name="group_by_trip_type" context="{'group_by': 'trip_type_id'}"/>
                    <filter string="Fuel Measurement" name="group_by_fuel_method" context="{'group_by': 'fuel_consumption_method'}"/>
                    <filter string="Planned Month" name="group_by_month" context="{'group_by': 'planned_departure:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Trip Reporting Pivot View -->
    <record id="view_top_fleet_trip_pivot" model="ir.ui.view">
        <field name="name">top.fleet.trip.pivot</field>
        <field name="model">top.fleet.trip</field>
        <field name="arch" type="xml">
            <pivot string="Trip Planned vs Actual Analysis" sample="1">
                <field name="vehicle_id" type="row"/>
                <field name="planned_departure" interval="month" type="col"/>
                <field name="planned_distance" type="measure"/>
                <field name="actual_distance" type="measure"/>
                <field name="variance_distance" type="measure"/>
                <field name="planned_duration" type="measure"/>
                <field name="actual_duration" type="measure"/>
                <field name="expected_fuel" type="measure"/>
                <field name="actual_fuel" type="measure"/>
                <field name="variance_fuel" type="measure"/>
                <field name="planned_cost" type="measure"/>
                <field name="total_trip_cost" type="measure"/>
                <field name="variance_cost" type="measure"/>
                <field name="cost_per_km" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Trip Reporting Graph View -->
    <record id="view_top_fleet_trip_graph" model="ir.ui.view">
        <field name="name">top.fleet.trip.graph</field>
        <field name="model">top.fleet.trip</field>
        <field name="arch" type="xml">
            <graph string="Trip Performance &amp; Variances" type="bar" sample="1">
                <field name="vehicle_id"/>
                <field name="actual_distance" type="measure"/>
                <field name="actual_fuel" type="measure"/>
                <field name="total_trip_cost" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Window Actions -->
    <record id="action_top_fleet_trip_all" model="ir.actions.act_window">
        <field name="name">All Trips</field>
        <field name="res_model">top.fleet.trip</field>
        <field name="view_mode">list,kanban,calendar,pivot,graph,form</field>
        <field name="search_view_id" ref="view_top_fleet_trip_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No trips recorded yet!
            </p>
            <p>
                Trips are generated upon vehicle &amp; driver assignment from approved transport requests.
            </p>
        </field>
    </record>

    <record id="action_top_fleet_trip_active" model="ir.actions.act_window">
        <field name="name">Active Trips</field>
        <field name="res_model">top.fleet.trip</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="domain">[('state', 'in', ['ready', 'dispatched', 'in_transit'])]</field>
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>

    <record id="action_top_fleet_trip_completed" model="ir.actions.act_window">
        <field name="name">Completed Trips</field>
        <field name="res_model">top.fleet.trip</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ['completed', 'reconciled', 'closed'])]</field>
    </record>

    <!-- Section 37: Vehicle Availability Calendar Action -->
    <record id="action_top_vehicle_availability_calendar" model="ir.actions.act_window">
        <field name="name">Vehicle Availability Calendar</field>
        <field name="res_model">top.fleet.trip</field>
        <field name="view_mode">calendar,kanban,list</field>
        <field name="view_id" ref="view_top_fleet_trip_calendar"/>
    </record>

    <!-- Sections 31 & 32: Fuel Consumption & Telematics Efficiency Action -->
    <record id="action_top_fleet_fuel_efficiency" model="ir.actions.act_window">
        <field name="name">Fuel Consumption &amp; Efficiency</field>
        <field name="res_model">top.fleet.trip</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['in_transit', 'completed', 'reconciled', 'closed'])]</field>
        <field name="context">{'search_default_group_by_vehicle': 1}</field>
        <field name="search_view_id" ref="view_top_fleet_trip_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No trips tracked for fuel efficiency yet!
            </p>
            <p>
                Track live and completed trips with real-time GPS tank levels, refuels, and benchmark consumption rates.
            </p>
        </field>
    </record>
    <!-- Reporting Action: Trip Planned vs Actual Analysis -->
    <record id="action_top_fleet_trip_reporting" model="ir.actions.act_window">
        <field name="name">Trip Planned vs Actual Performance</field>
        <field name="res_model">top.fleet.trip</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'search_default_group_by_vehicle': 1}</field>
        <field name="search_view_id" ref="view_top_fleet_trip_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No trip performance data available!
            </p>
            <p>
                Analyze planned vs. actual distance, travel time, fuel burn, and operating costs across vehicles and drivers.
            </p>
        </field>
    </record>
</odoo>
