<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_top_transport_request_type_list" model="ir.ui.view">
        <field name="name">top.transport.request.type.list</field>
        <field name="model">top.transport.request.type</field>
        <field name="arch" type="xml">
            <list string="Request Types">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_top_transport_request_type_form" model="ir.ui.view">
        <field name="name">top.transport.request.type.form</field>
        <field name="model">top.transport.request.type</field>
        <field name="arch" type="xml">
            <form string="Request Type">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe when this request type should be used..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_top_transport_request_type" model="ir.actions.act_window">
        <field name="name">Transport Request Types</field>
        <field name="res_model">top.transport.request.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new transport request type!
            </p>
            <p>
                Configure categories of transport requests such as Official Travel, Field Operation, Delivery, or Emergency.
            </p>
        </field>
    </record>
</odoo>
