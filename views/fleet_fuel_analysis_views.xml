<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fuel Analysis List View -->
    <record id="view_top_fleet_fuel_analysis_list" model="ir.ui.view">
        <field name="name">top.fleet.fuel.analysis.list</field>
        <field name="model">top.fleet.fuel.analysis</field>
        <field name="arch" type="xml">
            <list string="Fuel Consumption &amp; Efficiency Analytics"
                  decoration-danger="theft_suspected"
                  decoration-warning="efficiency_status == 'high'"
                  decoration-success="efficiency_status == 'efficient'">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="license_plate"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="distance_km" string="Distance (km)" class="fw-bold"/>
                <field name="start_fuel" string="Start Fuel (L)"/>
                <field name="end_fuel" string="End Fuel (L)"/>
                <field name="total_refueled" string="Refueled (L)"/>
                <field name="fuel_consumed" string="Consumed (L)" class="fw-bold text-primary"/>
                <field name="consumption_rate" string="Rate (L/100km)" class="fw-bold"
                       decoration-danger="consumption_rate &gt; benchmark_rate * 1.2"
                       decoration-success="consumption_rate &lt; benchmark_rate"/>
                <field name="benchmark_rate" string="Norm (L/100km)"/>
                <field name="efficiency_status" widget="badge"
                       decoration-success="efficiency_status == 'efficient'"
                       decoration-info="efficiency_status == 'normal'"
                       decoration-warning="efficiency_status == 'high'"
                       decoration-danger="efficiency_status == 'alert'"/>
                <field name="theft_suspected" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Fuel Analysis Pivot View -->
    <record id="view_top_fleet_fuel_analysis_pivot" model="ir.ui.view">
        <field name="name">top.fleet.fuel.analysis.pivot</field>
        <field name="model">top.fleet.fuel.analysis</field>
        <field name="arch" type="xml">
            <pivot string="Fuel Consumption &amp; Efficiency Pivot" sample="1">
                <field name="vehicle_id" type="row"/>
                <field name="date" interval="day" type="col"/>
                <field name="distance_km" type="measure"/>
                <field name="fuel_consumed" type="measure"/>
                <field name="total_refueled" type="measure"/>
                <field name="consumption_rate" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Fuel Analysis Graph View -->
    <record id="view_top_fleet_fuel_analysis_graph" model="ir.ui.view">
        <field name="name">top.fleet.fuel.analysis.graph</field>
        <field name="model">top.fleet.fuel.analysis</field>
        <field name="arch" type="xml">
            <graph string="Fuel Consumption by Vehicle" type="bar" sample="1">
                <field name="vehicle_id"/>
                <field name="fuel_consumed" type="measure"/>
                <field name="distance_km" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Fuel Analysis Form View -->
    <record id="view_top_fleet_fuel_analysis_form" model="ir.ui.view">
        <field name="name">top.fleet.fuel.analysis.form</field>
        <field name="model">top.fleet.fuel.analysis</field>
        <field name="arch" type="xml">
            <form string="Telematics Fuel Analysis">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Vehicle &amp; Period">
                            <field name="vehicle_id"/>
                            <field name="license_plate"/>
                            <field name="device_id"/>
                            <field name="driver_id"/>
                            <field name="period_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                        <group string="Distance &amp; Odometer">
                            <field name="start_odometer"/>
                            <field name="end_odometer"/>
                            <field name="distance_km" class="fw-bold fs-4 text-info"/>
                        </group>
                    </group>
                    <group>
                        <group string="Tank Levels &amp; Refills">
                            <field name="start_fuel"/>
                            <field name="end_fuel"/>
                            <field name="total_refueled"/>
                            <field name="refuel_count"/>
                            <field name="total_drained" invisible="total_drained == 0"/>
                            <field name="drain_count" invisible="drain_count == 0"/>
                        </group>
                        <group string="Consumption &amp; Efficiency KPIs">
                            <field name="fuel_consumed" class="fw-bold fs-4 text-primary"/>
                            <field name="consumption_rate" class="fw-bold fs-4 text-danger"/>
                            <field name="fuel_economy"/>
                            <field name="benchmark_rate"/>
                            <field name="variance_pct"/>
                            <field name="efficiency_status" widget="badge"/>
                            <field name="theft_suspected" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Fuel Analysis Search View -->
    <record id="view_top_fleet_fuel_analysis_search" model="ir.ui.view">
        <field name="name">top.fleet.fuel.analysis.search</field>
        <field name="model">top.fleet.fuel.analysis</field>
        <field name="arch" type="xml">
            <search string="Search Fuel Analysis">
                <field name="name"/>
                <field name="vehicle_id"/>
                <field name="license_plate"/>
                <filter string="High Consumption" name="filter_high" domain="[('efficiency_status', '=', 'high')]"/>
                <filter string="Suspected Drains / Theft" name="filter_alert" domain="[('theft_suspected', '=', True)]"/>
                <filter string="Fuel Efficient" name="filter_efficient" domain="[('efficiency_status', '=', 'efficient')]"/>
                <separator/>
                <filter string="Daily" name="filter_daily" domain="[('period_type', '=', 'daily')]"/>
                <filter string="Weekly" name="filter_weekly" domain="[('period_type', '=', 'weekly')]"/>
                <filter string="Monthly" name="filter_monthly" domain="[('period_type', '=', 'monthly')]"/>
                <group expand="0" string="Group By">
                    <filter string="Vehicle" name="group_by_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Rating" name="group_by_status" context="{'group_by': 'efficiency_status'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_top_fleet_fuel_analysis" model="ir.actions.act_window">
        <field name="name">Fuel Consumption &amp; Efficiency Analytics</field>
        <field name="res_model">top.fleet.fuel.analysis</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="search_view_id" ref="view_top_fleet_fuel_analysis_search"/>
        <field name="context">{'search_default_group_by_vehicle': 1}</field>
    </record>
</odoo>
