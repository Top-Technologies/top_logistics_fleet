<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_top_gps_device_list" model="ir.ui.view">
        <field name="name">top.gps.device.list</field>
        <field name="model">top.gps.device</field>
        <field name="arch" type="xml">
            <list string="GPS Devices" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="device_id"/>
                <field name="provider"/>
                <field name="vehicle_id"/>
                <field name="speed"/>
                <field name="odometer"/>
                <field name="fuel_level"/>
                <field name="battery"/>
                <field name="ignition" widget="boolean_toggle"/>
                <field name="last_communication"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-danger="status in ('offline', 'faulty')"
                       decoration-warning="status == 'suspended'"
                       decoration-muted="status == 'unassigned'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_top_gps_device_form" model="ir.ui.view">
        <field name="name">top.gps.device.form</field>
        <field name="model">top.gps.device</field>
        <field name="arch" type="xml">
            <form string="GPS Device">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="active,offline,suspended,faulty,unassigned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Device Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Wialon Tracker #101"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Hardware Specifications (Section 19)">
                            <field name="device_id"/>
                            <field name="imei"/>
                            <field name="sim_number"/>
                            <field name="provider"/>
                            <field name="vehicle_id"/>
                            <field name="installation_date"/>
                        </group>
                        <group string="Telemetry &amp; Signals">
                            <field name="last_communication"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="altitude"/>
                            <field name="speed"/>
                            <field name="direction"/>
                            <field name="ignition" widget="boolean_toggle"/>
                            <field name="odometer"/>
                            <field name="fuel_level"/>
                            <field name="battery"/>
                            <field name="gps_signal"/>
                            <field name="last_sync"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_top_gps_device_search" model="ir.ui.view">
        <field name="name">top.gps.device.search</field>
        <field name="model">top.gps.device</field>
        <field name="arch" type="xml">
            <search string="Search GPS Devices">
                <field name="name" string="Device, IMEI, or ID"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('imei', 'ilike', self), ('device_id', 'ilike', self)]"/>
                <field name="vehicle_id"/>
                <field name="provider"/>

                <separator/>
                <filter string="Active" name="filter_active" domain="[('status', '=', 'active')]"/>
                <filter string="Offline" name="filter_offline" domain="[('status', '=', 'offline')]"/>
                <filter string="Assigned to Vehicle" name="filter_assigned" domain="[('vehicle_id', '!=', False)]"/>
                <filter string="Unassigned" name="filter_unassigned" domain="[('vehicle_id', '=', False)]"/>

                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                    <filter string="Provider" name="group_by_provider" context="{'group_by': 'provider'}"/>
                    <filter string="Vehicle" name="group_by_vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_top_gps_device" model="ir.actions.act_window">
        <field name="name">GPS Devices</field>
        <field name="res_model">top.gps.device</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_top_gps_device_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register a GPS tracking device!
            </p>
            <p>
                Manage device hardware profiles, IMEIs, SIMs, and monitor real-time vehicle positions.
            </p>
        </field>
    </record>
</odoo>
