<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_top_transport_request_list" model="ir.ui.view">
        <field name="name">top.transport.request.list</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <list string="Transport Requests" decoration-danger="priority == 'emergency'" decoration-muted="state in ('draft', 'cancelled')" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="fleet_order_type_id"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="department_id"/>
                <field name="trip_type_id"/>
                <field name="origin_location_id" optional="show"/>
                <field name="destination_location_id" optional="show"/>
                <field name="origin" optional="hide"/>
                <field name="destination" optional="hide"/>
                <field name="total_stops_count" string="Stops" optional="show"/>
                <field name="required_date"/>
                <field name="return_date"/>
                <field name="assigned_vehicle_id"/>
                <field name="assigned_driver_id"/>
                <field name="cargo_required" widget="boolean_toggle" optional="hide"/>
                <field name="cargo_load_type" widget="badge" optional="hide"/>
                <field name="cargo_product_id" optional="hide"/>
                <field name="cargo_amount_qty" optional="hide"/>
                <field name="cargo_uom_id" optional="hide"/>
                <field name="cargo_total_tariff" widget="monetary" optional="hide"/>
                <field name="priority" widget="badge" 
                       decoration-danger="priority == 'emergency'" 
                       decoration-warning="priority == 'high'" 
                       decoration-info="priority == 'normal'" 
                       decoration-muted="priority == 'low'"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state in ('submitted', 'under_review')"
                       decoration-primary="state in ('approved', 'vehicle_search')"
                       decoration-warning="state in ('assigned', 'dispatched', 'in_transit')"
                       decoration-success="state in ('completed', 'reconciled', 'closed')"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_top_transport_request_form" model="ir.ui.view">
        <field name="name">top.transport.request.form</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <form string="Transport Request">
                <header>
                    <!-- Workflow Action Buttons -->
                    <button name="action_submit" string="Submit Request" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    
                    <button name="action_review" string="Review" type="object" class="btn-secondary"
                            invisible="state != 'submitted'"
                            groups="top_logistics_fleet.group_fleet_supervisor,top_logistics_fleet.group_department_approver,top_logistics_fleet.group_fleet_officer,top_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state not in ('submitted', 'under_review')"
                            groups="top_logistics_fleet.group_fleet_supervisor,top_logistics_fleet.group_department_approver,top_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="%(action_transport_request_reject_wizard)d" string="Reject" type="action" class="btn-danger"
                            invisible="state not in ('submitted', 'under_review')"
                            groups="top_logistics_fleet.group_fleet_supervisor,top_logistics_fleet.group_department_approver,top_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="action_vehicle_search" string="Search Vehicle" type="object" class="btn-secondary"
                            invisible="state != 'approved'"
                            groups="top_logistics_fleet.group_fleet_supervisor,top_logistics_fleet.group_fleet_officer,top_logistics_fleet.group_fleet_manager"/>
                    
                    <!-- Vehicle Assignment Wizard Trigger (Sections 10, 11, 12) -->
                    <button name="action_open_assignment_wizard" string="Assign Vehicle &amp; Driver" type="object" class="btn-primary"
                            invisible="state not in ('approved', 'vehicle_search') and (priority != 'emergency' or state in ('assigned', 'dispatched', 'in_transit', 'completed', 'reconciled', 'closed', 'rejected', 'cancelled'))"
                            groups="top_logistics_fleet.group_fleet_supervisor,top_logistics_fleet.group_fleet_officer,top_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                            invisible="state in ('in_transit', 'completed', 'reconciled', 'closed', 'rejected', 'cancelled')"/>
                    
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state not in ('rejected', 'cancelled')"/>

                    <!-- Status Bar -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,assigned,dispatched,in_transit,completed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_trip" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="trip_count == 0">
                            <field name="trip_count" widget="statinfo" string="Trip"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>

                    <div class="alert alert-warning" role="alert" invisible="not post_trip_review_required">
                        <strong>Emergency Fast-Track:</strong> This request was directly assigned. Post-trip review is required upon completion.
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Request Number"/>
                        <h1>
                            <field name="name" class="text-primary"/>
                        </h1>
                    </div>

                    <group>
                        <group name="requester_details" string="Requester &amp; Department">
                            <field name="requester_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group name="schedule_details" string="Schedule &amp; Classification">
                            <field name="fleet_order_type_id" options="{'no_create_edit': False}" placeholder="Select Approval Type..." readonly="state != 'draft'"/>
                            <field name="trip_type_id" readonly="state != 'draft'"/>
                            <field name="priority" widget="priority" readonly="state != 'draft'"/>
                            <field name="request_date"/>
                            <field name="required_date" readonly="state != 'draft'"/>
                            <field name="return_date" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="route_cargo" string="Route &amp; Endpoints">
                            <group>
                                <group name="route_info" string="Predefined Locations &amp; Endpoints">
                                    <field name="origin_location_id" options="{'no_create_edit': False}" placeholder="Select Predefined Origin..." readonly="state != 'draft'"/>
                                    <field name="origin" placeholder="e.g. Head Office / Addis Ababa" readonly="state != 'draft'"/>
                                    <field name="destination_location_id" options="{'no_create_edit': False}" placeholder="Select Predefined Destination..." readonly="state != 'draft'"/>
                                    <field name="destination" placeholder="e.g. Project Site / Adama" readonly="state != 'draft'"/>
                                    <field name="passenger_count" readonly="state != 'draft'"/>
                                </group>
                                <group name="transport_spec" string="Vehicle &amp; Cargo Requirements">
                                    <field name="vehicle_type_id" placeholder="e.g. Pickup, Sedan, Truck" readonly="state != 'draft'"/>
                                    <field name="driver_required" widget="boolean_toggle" readonly="state != 'draft'"/>
                                    <field name="cargo_required" widget="boolean_toggle" readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>

                        <page name="stops_page" string="Stops &amp; Multi-Drop Waypoints">
                            <div class="alert alert-info py-2 mb-2 d-flex justify-content-between align-items-center" role="status">
                                <div>
                                    <i class="fa fa-map-signs me-1"/> 
                                    <strong>Multi-Stop Flexibility:</strong> Add intermediate pickups, dropoffs, or waypoints. Stops can be cancelled or marked visited individually.
                                </div>
                                <div class="text-end">
                                    <span class="badge text-bg-primary me-1"><field name="total_stops_count"/> Planned</span>
                                    <span class="badge text-bg-success me-1"><field name="completed_stops_count"/> Visited</span>
                                    <span class="badge text-bg-danger"><field name="cancelled_stops_count"/> Cancelled</span>
                                </div>
                            </div>
                            <field name="stop_ids" readonly="state in ('completed', 'reconciled', 'closed', 'cancelled')">
                                <list editable="bottom" decoration-muted="state == 'pending'" decoration-success="state == 'completed'" decoration-danger="state == 'cancelled'">
                                    <field name="sequence" widget="handle"/>
                                    <field name="location_id" options="{'no_create_edit': False}" placeholder="Predefined Location..."/>
                                    <field name="location_name" placeholder="Stop / Destination Name"/>
                                    <field name="stop_type" widget="badge"/>
                                    <field name="cargo_or_passenger_notes" placeholder="Pick up / drop off details..."/>
                                    <field name="estimated_arrival"/>
                                    <field name="actual_arrival"/>
                                    <field name="state" widget="badge"
                                           decoration-muted="state == 'pending'"
                                           decoration-success="state == 'completed'"
                                           decoration-danger="state == 'cancelled'"/>
                                    <field name="notes" optional="show"/>
                                    <button name="action_mark_completed" string="Mark Visited" type="object" icon="fa-check text-success" invisible="state == 'completed'"/>
                                    <button name="action_cancel_stop" string="Cancel Stop" type="object" icon="fa-times text-danger" invisible="state in ('completed', 'cancelled')"/>
                                </list>
                            </field>
                        </page>

                        <page name="purpose_page" string="Purpose &amp; Description">
                            <field name="purpose" placeholder="Provide a detailed explanation of the travel or transport purpose..." readonly="state != 'draft'"/>
                        </page>

                        <page name="cargo_page" string="Cargo" invisible="not cargo_required">
                            <group name="cargo_details" string="📦 Cargo &amp; Freight Specifications">
                                <group string="Loading Type &amp; Product">
                                    <field name="cargo_load_type" widget="radio" options="{'horizontal': true}" readonly="state != 'draft'"/>
                                    <field name="cargo_product_id" options="{'no_create_edit': False}" placeholder="Select Loading Type / Product..." readonly="state != 'draft'"/>
                                    <field name="cargo_loading_type_desc" placeholder="e.g. Washed Coffee Beans Grade 1, Fertilizer Bags, Grain..." readonly="state != 'draft'"/>
                                    <field name="cargo_location_description" placeholder="Location description (e.g. Loading dock, warehouse gate, address, or handling instructions)..." readonly="state != 'draft'"/>
                                </group>
                                <group string="Capacity, Quantity &amp; Tariff">
                                    <label for="cargo_amount_qty" string="Amount In Quintal"/>
                                    <div class="o_row">
                                        <field name="cargo_amount_qty" readonly="state != 'draft'"/>
                                        <field name="cargo_uom_id" options="{'no_create': True}" placeholder="UoM..." readonly="state != 'draft'"/>
                                    </div>
                                    <label for="cargo_tariff_unit_price" string="Tariff (Unit Price) / Quintal"/>
                                    <div class="o_row">
                                        <field name="cargo_tariff_unit_price" readonly="state != 'draft'"/>
                                        <span class="text-muted ms-1 me-1"> per Quintal </span>
                                        <field name="cargo_uom_id" readonly="1" class="oe_inline"/>
                                    </div>
                                    <field name="cargo_currency_id" invisible="1"/>
                                    <field name="cargo_total_tariff" widget="monetary" readonly="1"/>
                                    <label for="cargo_load_capacity" string="Load Capacity"/>
                                    <div class="o_row">
                                        <field name="cargo_load_capacity" readonly="state != 'draft'"/>
                                        <field name="cargo_capacity_uom_id" options="{'no_create': True}" placeholder="Capacity UoM..." readonly="state != 'draft'"/>
                                    </div>
                                    <field name="cargo_description" placeholder="Additional cargo notes, weight, volume, or fragility instructions..." readonly="state != 'draft'"/>
                                </group>
                            </group>
                        </page>

                        <page name="approver_page" string="Approver">
                            <div class="alert alert-info py-2 mb-2 d-flex justify-content-between align-items-center" role="status">
                                <div>
                                    <i class="fa fa-users me-1"/>
                                    <strong>Multi-Level Approval Workflow:</strong> Add as many approvers as needed for this transport request. Approvers can review and approve or reject individually.
                                </div>
                                <div class="text-end">
                                    <span class="badge text-bg-primary me-1"><field name="approvers_count"/> Total Approvers</span>
                                    <span class="badge text-bg-warning"><field name="pending_approvers_count"/> Pending</span>
                                </div>
                            </div>
                            <field name="approver_ids" readonly="state in ('completed', 'reconciled', 'closed', 'cancelled')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="user_id" options="{'no_create': True}"/>
                                    <field name="role" placeholder="e.g. Department Manager, Fleet Supervisor, Cargo Manager..."/>
                                    <field name="status" widget="badge"
                                           decoration-info="status == 'pending'"
                                           decoration-success="status == 'approved'"
                                           decoration-danger="status == 'rejected'"/>
                                    <field name="action_date" readonly="1"/>
                                    <field name="comments" placeholder="Comments or approval/rejection remarks..."/>
                                    <button name="action_approve" type="object" string="Approve" icon="fa-check text-success" invisible="status == 'approved'"/>
                                    <button name="action_reject" type="object" string="Reject" icon="fa-times text-danger" invisible="status == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_top_transport_request_kanban" model="ir.ui.view">
        <field name="name">top.transport.request.kanban</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="trip_type_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="required_date"/>
                <field name="priority"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="o_kanban_record_title text-primary">
                                    <field name="name"/>
                                </strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="text-muted small mb-1">
                                <i class="fa fa-user me-1"/> <field name="requester_id"/>
                                <span t-if="record.department_id.value"> (<field name="department_id"/>)</span>
                            </div>
                            <div class="mb-1 small">
                                <i class="fa fa-map-marker text-danger me-1"/> 
                                <field name="origin"/> ➔ <field name="destination"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top">
                                <span class="small text-muted">
                                    <i class="fa fa-calendar me-1"/> <field name="required_date"/>
                                </span>
                                <field name="trip_type_id" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_top_transport_request_calendar" model="ir.ui.view">
        <field name="name">top.transport.request.calendar</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <calendar string="Transport Requests" date_start="required_date" date_stop="return_date" color="department_id" mode="month">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_top_transport_request_search" model="ir.ui.view">
        <field name="name">top.transport.request.search</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <search string="Search Transport Requests">
                <field name="name" string="Request Number or Origin/Destination" 
                       filter_domain="['|', '|', ('name', 'ilike', self), ('origin', 'ilike', self), ('destination', 'ilike', self)]"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="trip_type_id"/>
                
                <separator/>
                <filter string="My Requests" name="filter_my_requests" domain="[('requester_id', '=', uid)]"/>
                <filter string="To Approve" name="filter_to_approve" domain="[('state', 'in', ['submitted', 'under_review'])]"/>
                <filter string="Approved / Ready for Assignment" name="filter_approved" domain="[('state', 'in', ['approved', 'vehicle_search'])]"/>
                <filter string="Active Trips" name="filter_active_trips" domain="[('state', 'in', ['assigned', 'dispatched', 'in_transit'])]"/>
                <filter string="Completed &amp; Closed" name="filter_closed" domain="[('state', 'in', ['completed', 'reconciled', 'closed'])]"/>
                
                <separator/>
                <filter string="Cargo Requests" name="filter_cargo" domain="[('cargo_required', '=', True)]"/>
                <filter string="Full Load" name="filter_full_load" domain="[('cargo_load_type', '=', 'full'), ('cargo_required', '=', True)]"/>
                <filter string="Empty Load" name="filter_empty_load" domain="[('cargo_load_type', '=', 'empty'), ('cargo_required', '=', True)]"/>
                <filter string="Emergency Priority" name="filter_emergency" domain="[('priority', '=', 'emergency')]"/>
                <filter string="High Priority" name="filter_high" domain="[('priority', 'in', ['high', 'emergency'])]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Fleet Order Type" name="group_by_fleet_order_type" context="{'group_by': 'fleet_order_type_id'}"/>
                    <filter string="Cargo Load Type" name="group_cargo_load_type" context="{'group_by': 'cargo_load_type'}"/>
                    <filter string="Cargo Product" name="group_cargo_product" context="{'group_by': 'cargo_product_id'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Requester" name="group_by_requester" context="{'group_by': 'requester_id'}"/>
                    <filter string="Trip Type" name="group_by_trip_type" context="{'group_by': 'trip_type_id'}"/>
                    <filter string="Priority" name="group_by_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Required Month" name="group_by_date" context="{'group_by': 'required_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main Window Action -->
    <record id="action_top_transport_request_all" model="ir.actions.act_window">
        <field name="name">Transport Requests</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_top_transport_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first transport request!
            </p>
            <p>
                Submit requests for company vehicles, drivers, passenger transport, field missions, cargo movement, or emergency transport.
            </p>
        </field>
    </record>

    <!-- Filtered Action: My Requests -->
    <record id="action_top_transport_request_my" model="ir.actions.act_window">
        <field name="name">My Transport Requests</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
        <field name="context">{'default_requester_id': uid}</field>
    </record>

    <!-- Filtered Action: To Approve -->
    <record id="action_top_transport_request_to_approve" model="ir.actions.act_window">
        <field name="name">Requests to Approve</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ['submitted', 'under_review'])]</field>
    </record>

    <!-- Filtered Action: Allocation / Assignment -->
    <record id="action_top_transport_request_allocation" model="ir.actions.act_window">
        <field name="name">Requests for Vehicle Assignment</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ['approved', 'vehicle_search'])]</field>
    </record>
</odoo>
