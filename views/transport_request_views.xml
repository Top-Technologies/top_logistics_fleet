<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_top_transport_request_list" model="ir.ui.view">
        <field name="name">top.transport.request.list</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <list string="Transport Requests" decoration-danger="priority == 'emergency'" decoration-muted="state in ('draft', 'cancelled')" sample="1">
                <field name="name" decoration-bf="1"/>
                <field name="requester_id" widget="many2one_avatar_user"/>
                <field name="department_id"/>
                <field name="trip_type_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="required_date"/>
                <field name="return_date"/>
                <field name="assigned_vehicle_id"/>
                <field name="assigned_driver_id"/>
                <field name="priority" widget="badge" 
                       decoration-danger="priority == 'emergency'" 
                       decoration-warning="priority == 'high'" 
                       decoration-info="priority == 'normal'" 
                       decoration-muted="priority == 'low'"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state in ('submitted', 'under_review')"
                       decoration-primary="state in ('approved', 'vehicle_search')"
                       decoration-warning="state in ('assigned', 'dispatched', 'in_transit')"
                       decoration-success="state in ('completed', 'reconciled', 'closed')"
                       decoration-danger="state in ('rejected', 'cancelled')"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_top_transport_request_form" model="ir.ui.view">
        <field name="name">top.transport.request.form</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <form string="Transport Request">
                <header>
                    <!-- Workflow Action Buttons -->
                    <button name="action_submit" string="Submit Request" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    
                    <button name="action_review" string="Review" type="object" class="btn-secondary"
                            invisible="state != 'submitted'"
                            groups="top_logistics_fleet.group_department_approver,top_logistics_fleet.group_fleet_officer,top_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="action_approve" string="Approve" type="object" class="btn-primary"
                            invisible="state not in ('submitted', 'under_review')"
                            groups="top_logistics_fleet.group_department_approver,top_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="%(action_transport_request_reject_wizard)d" string="Reject" type="action" class="btn-danger"
                            invisible="state not in ('submitted', 'under_review')"
                            groups="top_logistics_fleet.group_department_approver,top_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="action_vehicle_search" string="Search Vehicle" type="object" class="btn-secondary"
                            invisible="state != 'approved'"
                            groups="top_logistics_fleet.group_fleet_officer,top_logistics_fleet.group_fleet_manager"/>
                    
                    <!-- Vehicle Assignment Wizard Trigger (Sections 10, 11, 12) -->
                    <button name="action_open_assignment_wizard" string="Assign Vehicle &amp; Driver" type="object" class="btn-primary"
                            invisible="state not in ('approved', 'vehicle_search') and (priority != 'emergency' or state in ('assigned', 'dispatched', 'in_transit', 'completed', 'reconciled', 'closed', 'rejected', 'cancelled'))"
                            groups="top_logistics_fleet.group_fleet_officer,top_logistics_fleet.group_fleet_manager"/>
                    
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                            invisible="state in ('in_transit', 'completed', 'reconciled', 'closed', 'rejected', 'cancelled')"/>
                    
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state not in ('rejected', 'cancelled')"/>

                    <!-- Status Bar -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,assigned,dispatched,in_transit,completed,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_trip" type="object" class="oe_stat_button" icon="fa-truck"
                                invisible="trip_count == 0">
                            <field name="trip_count" widget="statinfo" string="Trip"/>
                        </button>
                    </div>

                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>

                    <div class="alert alert-warning" role="alert" invisible="not post_trip_review_required">
                        <strong>Emergency Fast-Track:</strong> This request was directly assigned. Post-trip review is required upon completion.
                    </div>

                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Request Number"/>
                        <h1>
                            <field name="name" class="text-primary"/>
                        </h1>
                    </div>

                    <group>
                        <group name="requester_details" string="Requester &amp; Department">
                            <field name="requester_id" widget="many2one_avatar_user" readonly="state != 'draft'"/>
                            <field name="employee_id" readonly="state != 'draft'"/>
                            <field name="department_id" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                        <group name="schedule_details" string="Schedule &amp; Priority">
                            <field name="trip_type_id" readonly="state != 'draft'"/>
                            <field name="priority" widget="priority" readonly="state != 'draft'"/>
                            <field name="request_date"/>
                            <field name="required_date" readonly="state != 'draft'"/>
                            <field name="return_date" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="route_cargo" string="Route &amp; Requirements">
                            <group>
                                <group name="route_info" string="Route Details">
                                    <field name="origin" placeholder="e.g. Head Office / Addis Ababa" readonly="state != 'draft'"/>
                                    <field name="destination" placeholder="e.g. Project Site / Adama" readonly="state != 'draft'"/>
                                    <field name="passenger_count" readonly="state != 'draft'"/>
                                </group>
                                <group name="transport_spec" string="Vehicle &amp; Cargo Requirements">
                                    <field name="vehicle_type_id" placeholder="e.g. Pickup, Sedan, Truck" readonly="state != 'draft'"/>
                                    <field name="driver_required" widget="boolean_toggle" readonly="state != 'draft'"/>
                                    <field name="cargo_required" widget="boolean_toggle" readonly="state != 'draft'"/>
                                    <field name="cargo_description" invisible="not cargo_required" readonly="state != 'draft'" placeholder="Details about cargo weight, volume, or fragility..."/>
                                </group>
                            </group>
                        </page>

                        <page name="purpose_page" string="Purpose &amp; Description">
                            <field name="purpose" placeholder="Provide a detailed explanation of the travel or transport purpose..." readonly="state != 'draft'"/>
                        </page>

                        <page name="allocation_page" string="Allocation &amp; Assignment" invisible="state in ('draft', 'submitted', 'under_review')">
                            <group>
                                <group string="Assigned Resources (Section 11)">
                                    <field name="assigned_vehicle_id"/>
                                    <field name="assigned_driver_id"/>
                                    <field name="trip_id"/>
                                </group>
                                <group string="Approval Audit (Section 9)">
                                    <field name="reviewed_by_id"/>
                                    <field name="approved_by_id"/>
                                    <field name="approval_date"/>
                                    <field name="post_trip_review_required" widget="boolean_toggle"/>
                                </group>
                            </group>
                            <div class="alert alert-danger mt-3" role="alert" invisible="state != 'rejected'">
                                <strong>Rejection Reason:</strong>
                                <p><field name="rejection_reason" readonly="1"/></p>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_top_transport_request_kanban" model="ir.ui.view">
        <field name="name">top.transport.request.kanban</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <field name="id"/>
                <field name="name"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="trip_type_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="required_date"/>
                <field name="priority"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click p-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="o_kanban_record_title text-primary">
                                    <field name="name"/>
                                </strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div class="text-muted small mb-1">
                                <i class="fa fa-user me-1"/> <field name="requester_id"/>
                                <span t-if="record.department_id.value"> (<field name="department_id"/>)</span>
                            </div>
                            <div class="mb-1 small">
                                <i class="fa fa-map-marker text-danger me-1"/> 
                                <field name="origin"/> ➔ <field name="destination"/>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-1 border-top">
                                <span class="small text-muted">
                                    <i class="fa fa-calendar me-1"/> <field name="required_date"/>
                                </span>
                                <field name="trip_type_id" widget="badge"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Calendar View -->
    <record id="view_top_transport_request_calendar" model="ir.ui.view">
        <field name="name">top.transport.request.calendar</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <calendar string="Transport Requests" date_start="required_date" date_stop="return_date" color="department_id" mode="month">
                <field name="name"/>
                <field name="requester_id"/>
                <field name="origin"/>
                <field name="destination"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_top_transport_request_search" model="ir.ui.view">
        <field name="name">top.transport.request.search</field>
        <field name="model">top.transport.request</field>
        <field name="arch" type="xml">
            <search string="Search Transport Requests">
                <field name="name" string="Request Number or Origin/Destination" 
                       filter_domain="['|', '|', ('name', 'ilike', self), ('origin', 'ilike', self), ('destination', 'ilike', self)]"/>
                <field name="requester_id"/>
                <field name="department_id"/>
                <field name="trip_type_id"/>
                
                <separator/>
                <filter string="My Requests" name="filter_my_requests" domain="[('requester_id', '=', uid)]"/>
                <filter string="To Approve" name="filter_to_approve" domain="[('state', 'in', ['submitted', 'under_review'])]"/>
                <filter string="Approved / Ready for Assignment" name="filter_approved" domain="[('state', 'in', ['approved', 'vehicle_search'])]"/>
                <filter string="Active Trips" name="filter_active_trips" domain="[('state', 'in', ['assigned', 'dispatched', 'in_transit'])]"/>
                <filter string="Completed &amp; Closed" name="filter_closed" domain="[('state', 'in', ['completed', 'reconciled', 'closed'])]"/>
                
                <separator/>
                <filter string="Emergency Priority" name="filter_emergency" domain="[('priority', '=', 'emergency')]"/>
                <filter string="High Priority" name="filter_high" domain="[('priority', 'in', ['high', 'emergency'])]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Requester" name="group_by_requester" context="{'group_by': 'requester_id'}"/>
                    <filter string="Trip Type" name="group_by_trip_type" context="{'group_by': 'trip_type_id'}"/>
                    <filter string="Priority" name="group_by_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Required Month" name="group_by_date" context="{'group_by': 'required_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Main Window Action -->
    <record id="action_top_transport_request_all" model="ir.actions.act_window">
        <field name="name">Transport Requests</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,calendar,form</field>
        <field name="search_view_id" ref="view_top_transport_request_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first transport request!
            </p>
            <p>
                Submit requests for company vehicles, drivers, passenger transport, field missions, cargo movement, or emergency transport.
            </p>
        </field>
    </record>

    <!-- Filtered Action: My Requests -->
    <record id="action_top_transport_request_my" model="ir.actions.act_window">
        <field name="name">My Transport Requests</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('requester_id', '=', uid)]</field>
        <field name="context">{'default_requester_id': uid}</field>
    </record>

    <!-- Filtered Action: To Approve -->
    <record id="action_top_transport_request_to_approve" model="ir.actions.act_window">
        <field name="name">Requests to Approve</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ['submitted', 'under_review'])]</field>
    </record>

    <!-- Filtered Action: Allocation / Assignment -->
    <record id="action_top_transport_request_allocation" model="ir.actions.act_window">
        <field name="name">Requests for Vehicle Assignment</field>
        <field name="res_model">top.transport.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="domain">[('state', 'in', ['approved', 'vehicle_search'])]</field>
    </record>
</odoo>
