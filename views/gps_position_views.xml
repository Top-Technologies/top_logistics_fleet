<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_top_gps_position_list" model="ir.ui.view">
        <field name="name">top.gps.position.list</field>
        <field name="model">top.gps.position</field>
        <field name="arch" type="xml">
            <list string="GPS Telemetry Logs" create="false" edit="false">
                <field name="timestamp"/>
                <field name="vehicle_id"/>
                <field name="trip_id"/>
                <field name="latitude"/>
                <field name="longitude"/>
                <field name="speed"/>
                <field name="direction"/>
                <field name="ignition" widget="boolean_toggle"/>
                <field name="odometer"/>
                <field name="engine_status" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_top_gps_position_search" model="ir.ui.view">
        <field name="name">top.gps.position.search</field>
        <field name="model">top.gps.position</field>
        <field name="arch" type="xml">
            <search string="Search Position Logs">
                <field name="vehicle_id"/>
                <field name="trip_id"/>
                <field name="device_id"/>
                <filter string="Engine Running" name="filter_running" domain="[('engine_status', '=', 'running')]"/>
                <filter string="Idling" name="filter_idling" domain="[('engine_status', '=', 'idling')]"/>
                <group expand="0" string="Group By">
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Trip" name="group_trip" context="{'group_by': 'trip_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'timestamp:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_top_gps_position" model="ir.actions.act_window">
        <field name="name">GPS Position Logs</field>
        <field name="res_model">top.gps.position</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_top_gps_position_search"/>
    </record>
</odoo>
