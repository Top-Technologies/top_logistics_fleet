<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Default Approval Categories for Fleet & Logistics (Many-to-One with Approval Module) -->
        <record id="approval_category_fleet_transport" model="approval.category">
            <field name="name">Fleet Transport Request (የተሽከርካሪ ትራንስፖርት)</field>
            <field name="description">Standard transport order and vehicle dispatch approval workflow.</field>
            <field name="has_date">optional</field>
            <field name="has_period">optional</field>
            <field name="has_location">optional</field>
            <field name="approval_minimum">1</field>
            <field name="sequence">50</field>
        </record>

        <record id="approval_category_light_fleet" model="approval.category">
            <field name="name">Light Fleet Transport (ቀላል ተሽከርካሪ)</field>
            <field name="description">Sedan, pickup truck, station wagon, and minibus transport requests.</field>
            <field name="has_date">optional</field>
            <field name="has_period">optional</field>
            <field name="has_location">optional</field>
            <field name="approval_minimum">1</field>
            <field name="sequence">51</field>
        </record>

        <record id="approval_category_heavy_fleet" model="approval.category">
            <field name="name">Heavy Fleet Transport (ከባድ ተሽከርካሪ)</field>
            <field name="description">Heavy freight trucks, trailers, dumpers, and lowbed machinery transport requests.</field>
            <field name="has_date">optional</field>
            <field name="has_period">optional</field>
            <field name="has_location">optional</field>
            <field name="approval_minimum">1</field>
            <field name="sequence">52</field>
        </record>
    </data>
</odoo>
