<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Transport Request Notifications (Section 50) -->
        <record id="mail_act_request_awaiting_approval" model="mail.activity.type">
            <field name="name">Transport Request Awaiting Approval</field>
            <field name="icon">fa-check-square-o</field>
            <field name="sequence">5</field>
            <field name="summary">Transport request submitted and requires approval</field>
            <field name="res_model">top.transport.request</field>
            <field name="category">default</field>
        </record>

        <record id="mail_act_vehicle_assigned" model="mail.activity.type">
            <field name="name">Vehicle Assigned</field>
            <field name="icon">fa-truck</field>
            <field name="sequence">8</field>
            <field name="summary">Vehicle and driver assigned to transport request</field>
            <field name="res_model">top.transport.request</field>
            <field name="category">default</field>
        </record>

        <!-- 2. Trip Notifications (Section 50) -->
        <record id="mail_act_trip_dispatched" model="mail.activity.type">
            <field name="name">Trip Dispatched</field>
            <field name="icon">fa-road</field>
            <field name="sequence">9</field>
            <field name="summary">Vehicle cleared pre-dispatch inspection and departed</field>
            <field name="res_model">top.fleet.trip</field>
            <field name="category">default</field>
        </record>

        <record id="mail_act_trip_delay" model="mail.activity.type">
            <field name="name">Trip Delay Detected</field>
            <field name="icon">fa-clock-o</field>
            <field name="sequence">15</field>
            <field name="summary">Trip past planned arrival time while still in transit</field>
            <field name="res_model">top.fleet.trip</field>
            <field name="category">default</field>
        </record>

        <!-- 3. Maintenance Due (Section 33 & 50) -->
        <record id="mail_act_maintenance_due" model="mail.activity.type">
            <field name="name">Vehicle Maintenance Due</field>
            <field name="icon">fa-wrench</field>
            <field name="sequence">20</field>
            <field name="summary">Scheduled preventive service interval reached</field>
            <field name="res_model">fleet.vehicle</field>
            <field name="category">default</field>
        </record>

        <!-- 4. Driver License Expiring (Section 13 & 50) -->
        <record id="mail_act_license_expiring" model="mail.activity.type">
            <field name="name">Driver License Expiring</field>
            <field name="icon">fa-id-card</field>
            <field name="sequence">25</field>
            <field name="summary">Driver license expiration within warning window</field>
            <field name="res_model">hr.employee</field>
            <field name="category">default</field>
        </record>

        <!-- 5. Vehicle Document Expiring (Section 12 & 53) -->
        <record id="mail_act_doc_expiring" model="mail.activity.type">
            <field name="name">Vehicle Document Expiring</field>
            <field name="icon">fa-file-text-o</field>
            <field name="sequence">30</field>
            <field name="summary">Insurance, registration, or inspection expiration</field>
            <field name="res_model">fleet.vehicle</field>
            <field name="category">default</field>
        </record>

        <!-- 6. Overspeed Event Detected (Section 28, 50, 53) -->
        <record id="mail_act_overspeed" model="mail.activity.type">
            <field name="name">Overspeed Event Detected</field>
            <field name="icon">fa-tachometer</field>
            <field name="sequence">40</field>
            <field name="summary">Vehicle exceeded configured road speed limit</field>
            <field name="res_model">top.fleet.trip</field>
            <field name="category">default</field>
        </record>

        <!-- 7. Vehicle GPS Offline (Section 50 & 53) -->
        <record id="mail_act_gps_offline" model="mail.activity.type">
            <field name="name">Vehicle GPS Offline</field>
            <field name="icon">fa-signal</field>
            <field name="sequence">50</field>
            <field name="summary">GPS tracking device offline beyond threshold</field>
            <field name="res_model">top.gps.device</field>
            <field name="category">default</field>
        </record>
    </data>
</odoo>
