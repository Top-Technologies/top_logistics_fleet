<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Scheduled Action for Periodic GPS Sync (Sections 22 & 47) -->
        <record id="ir_cron_sync_gps_telemetry" model="ir.cron">
            <field name="name">FMS: Periodic GPS Telemetry Sync</field>
            <field name="model_id" ref="model_top_gps_provider"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_all_active_providers()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 2. Scheduled Action for Vehicle Compliance & Service Due Alerts (Sections 50 & 53) -->
        <record id="ir_cron_check_vehicle_alerts" model="ir.cron">
            <field name="name">FMS: Daily Vehicle Document &amp; Service Alert Scanner</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_compliance_and_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 3. Scheduled Action for Driver License Expiration Alerts (Sections 50 & 53) -->
        <record id="ir_cron_check_driver_license_alerts" model="ir.cron">
            <field name="name">FMS: Daily Driver License Expiry Alert Scanner</field>
            <field name="model_id" ref="hr.model_hr_employee"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_driver_license_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 4. Scheduled Action for GPS Data Retention Cleanup (Section 48) -->
        <record id="ir_cron_purge_historical_positions" model="ir.cron">
            <field name="name">FMS: Purge Historical Raw GPS Positions (Data Retention)</field>
            <field name="model_id" ref="model_top_gps_provider"/>
            <field name="state">code</field>
            <field name="code">model.cron_purge_all_providers_retention()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 5. Scheduled Action for Trip Delay Detection (Section 50) -->
        <record id="ir_cron_check_trip_delays" model="ir.cron">
            <field name="name">FMS: Trip Delay Scanner</field>
            <field name="model_id" ref="model_top_fleet_trip"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_trip_delays()</field>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <!-- 6. Scheduled Action for Offline GPS Device Detection (Section 50 & 53) -->
        <record id="ir_cron_check_offline_devices" model="ir.cron">
            <field name="name">FMS: Offline GPS Device Scanner</field>
            <field name="model_id" ref="model_top_gps_device"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_offline_devices()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
